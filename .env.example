# ==========================================
# TRUEHIVE CRM & ERP - ENVIRONMENT VARIABLES
# ==========================================

# 1. Database (Supabase PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. JWT & Auth Security
JWT_SECRET="truehive-super-secret-jwt-key-change-in-production-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. WhatsApp Cloud API (Meta Official)
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_waba_id"
WHATSAPP_ACCESS_TOKEN="your_permanent_system_user_access_token"
WHATSAPP_VERIFY_TOKEN="truehive_webhook_verify_token_2026"

# 4. Google Gemini AI (Agentic Loop & Multimodal)
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"

# 5. Redis (ioredis - Message Buffer, Live Stock Cache & Rate Limiter)
REDIS_URL="redis://default:your_password@your_redis_host:6379"

# 6. Pusher (Real-time Live Chat & POS Stock Sync)
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# 7. Firebase (FCM Push Notifications)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# 8. Cloudinary (Products, Payment Slips, Voice Notes & Invoices)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# 9. Resend (Transactional Emails & Official Invoices)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="TrueHive CRM <orders@truehive.lk>"

# 10. Zoho Marketing Campaigns
ZOHO_CLIENT_ID="your_zoho_client_id"
ZOHO_CLIENT_SECRET="your_zoho_client_secret"
ZOHO_REFRESH_TOKEN="your_zoho_refresh_token"
ZOHO_LIST_KEY="your_zoho_mailing_list_key"

# 11. Google Docs & Google Sheets Live Reporting API
GOOGLE_CLIENT_EMAIL="truehive-reporter@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_LIVE_DOC_ID="your_google_doc_id"
GOOGLE_LIVE_SHEET_ID="your_google_sheet_id"

